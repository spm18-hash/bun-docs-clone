---
import type { SvgComponent } from "astro/types";
import Icons from "../Icons.astro";

interface Props {
    icon: SvgComponent & ImageMetadata;
    label: string;
    description: string;
    href?: string;
}

const { icon, label, description, href } = Astro.props;

const Icon = icon;
---

<div class="item-container">
    <div class="icon">
        <Icon />
    </div>
    <div>
        <div class="label-container">
            <h3>{label}</h3>
            {href && <Icons name="arrow-up-right" size="0.75em" />}
        </div>
        <p>{description}</p>
    </div>
    {href && <a href={href} aria-label={label} />}
</div>

<style>
    .item-container {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem;
        border-radius: calc(0.85rem - 0.25rem);
        position: relative;
        cursor: pointer;

        & .label-container {
            display: flex;
            width: 100%;
            align-items: center;
            gap: 0.25rem;
        }

        & a {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        &:hover {
            background-color: var(--card-bg-hover);

            .icon {
                border-color: var(--sl-color-gray-5);
            }
        }

        & .icon {
            height: 100%;
            width: auto;
            aspect-ratio: 1;
            border: 1px solid var(--sl-color-gray-6);
            padding: 0.375rem;
            border-radius: 0.4rem;
            display: flex;
            align-items: center;
            justify-content: center;

            & svg {
                width: 1rem;
                height: 1rem;
                flex-shrink: 0;
            }
        }

        & h3 {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--sl-color-white);
            line-height: calc(1.25 / 0.875);
        }
        & p {
            font-size: 0.75rem;
            line-height: calc(1 / 0.75);
            color: var(--sl-gray-2);
            margin-top: 0;
        }
    }
</style>
