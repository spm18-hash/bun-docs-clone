---
import Icons from "./Icons.astro";

const currentPage = Astro.locals.starlightRoute.entry.data.title;
const parentDirectory = Astro.locals.starlightRoute.entry.data.parentDirectory;
---

<nav aria-label="Breadcrumb" class="breadcrumb-container">
    <ol>
        <li>
            <span
                id="breadcrumb-toggle"
                role="button"
                tabindex="0"
                aria-label="Toggle sidebar menu"
                class="previous-page">{parentDirectory}</span
            >
        </li>
        <Icons name="chevron-down" class="chevron-right" />
        <li>
            <span aria-current="page" class="current-page">{currentPage}</span>
        </li>
    </ol>
</nav>

<style>
    .breadcrumb-container {
        @media (min-width: 64rem) {
            display: none;
        }

        & ol {
            display: flex;
            padding: 0;
            margin: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 14px;
            line-height: 20px;

            & li {
                list-style-type: none;

                & span[aria-current="page"] {
                    color: var(--sl-color-white);
                    font-weight: 500;
                }
            }
        }
    }

    .previous-page {
        text-transform: capitalize;
        color: var(--sl-color-gray-3);
    }

    .chevron-right {
        transform: rotate(-90deg);
        color: var(--sl-color-white);
    }
</style>

<script>
    const breadcrumbToggle = document.getElementById("breadcrumb-toggle");

    const menuButton = document.getElementById("mobile-menu-btn");

    if (
        breadcrumbToggle instanceof HTMLSpanElement &&
        menuButton instanceof HTMLButtonElement
    ) {
        breadcrumbToggle.addEventListener("click", () => {
            menuButton.click();
        });

        breadcrumbToggle.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                menuButton.click();
            }
        });
    }
</script>
