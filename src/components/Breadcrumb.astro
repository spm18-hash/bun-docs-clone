---
import Icons from "./Icons.astro";

import type { SidebarEntry } from "node_modules/@astrojs/starlight/utils/routing/types";

const {
    sidebar,
    entry: {
        data: { title: currentPage },
    },
} = Astro.locals.starlightRoute;

export function getActiveBreadcrumb(
    sidebar: SidebarEntry[],
    currentPage: string,
) {
    let result = { parent: null as string | null, current: currentPage };

    function search(
        entries: SidebarEntry[],
        parentLabel: string | null,
    ): boolean {
        for (const item of entries) {
            if (item.type === "link" && item.isCurrent) {
                result = { parent: parentLabel, current: item.label };
                return true;
            }

            if (item.type === "group") {
                const foundLabel = search(item.entries, item.label);
                if (foundLabel) return true;
            }
        }
        return false;
    }

    search(sidebar, null);
    return result;
}

const { parent, current } = getActiveBreadcrumb(sidebar, currentPage);
---

<nav aria-label="Breadcrumb" class="breadcrumb-container">
    <ol>
        <li>
            <span
                id="breadcrumb-toggle"
                role="button"
                tabindex="0"
                aria-label="Toggle sidebar menu"
                class="previous-page">{parent}</span
            >
        </li>
        <Icons name="chevron-down" class="chevron-right" />
        <li>
            <span aria-current="page" class="current-page">{current}</span>
        </li>
    </ol>
</nav>

<style>
    .breadcrumb-container {
        @media (min-width: 64rem) {
            display: none;
        }

        & ol {
            display: flex;
            padding: 0;
            margin: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 14px;
            line-height: 20px;

            & li {
                list-style-type: none;

                & span[aria-current="page"] {
                    color: var(--sl-color-white);
                    font-weight: 500;
                }
            }
        }
    }

    .previous-page {
        text-transform: capitalize;
        color: var(--sl-color-gray-3);
    }

    .chevron-right {
        transform: rotate(-90deg);
        color: var(--sl-color-white);
    }
</style>

<script>
    const breadcrumbToggle = document.getElementById("breadcrumb-toggle");

    const menuButton = document.getElementById("mobile-menu-btn");

    if (
        breadcrumbToggle instanceof HTMLSpanElement &&
        menuButton instanceof HTMLButtonElement
    ) {
        breadcrumbToggle.addEventListener("click", () => {
            menuButton.click();
        });

        breadcrumbToggle.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                menuButton.click();
            }
        });
    }
</script>
