---
import Icons from "../Icons.astro";
---

<h3 data-slot="accordion-trigger">
    <button type="button" aria-expanded="false" aria-disabled="false">
        <slot />
        <Icons name="chevron-down" class="trigger-icon" />
    </button>
</h3>

<style>
    h3 {
        display: flex;
        align-items: center;
        width: 100%;
    }

    button {
        background: none;
        border: none;
        outline: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 400;
        gap: 0.5rem;
        width: 100%;
        font-size: var(--sl-text-body);
    }
    .trigger-icon {
        transition: transform 0.125s ease;
    }
    button[aria-expanded="true"] .trigger-icon {
        transform: rotate(-180deg);
    }
</style>
