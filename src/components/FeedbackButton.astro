---
import Icons from "@/components/Icons.astro";
import type { StarlightIcon } from "./Icons";

interface Props {
    label: string;
    icon: StarlightIcon;
}

const { label, icon } = Astro.props;
---

<button class="sl-flex print:hidden">
    <Icons name={icon} size="1.2em" />
    {label}
</button>

<style>
    button {
        font-size: 0.875rem;
        line-height: 1rem;
        gap: 0.75rem;
        align-items: center;
        text-decoration: none;
        color: var(--sl-color-gray-2);
        background-color: var(--sl-color-bg);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        padding: 0.5rem 0.875rem;

        &:hover {
            color: var(--sl-color-white);
            border: 1px solid var(--sl-color-gray-3);
        }
    }
</style>
