---
import Icons from "@/components/Icons.astro";
import type { StarlightIcon } from "./Icons";

interface Props {
    href: string | URL | null | undefined;
    label: string;
    icon: StarlightIcon;
}

const { href, label, icon } = Astro.props;
---

<a href={href} class="sl-flex print:hidden">
    <Icons name={icon} size="1.2em" />
    {label}
</a>

<style>
    @layer starlight.core {
        a {
            font-size: 0.875rem;
            line-height: 1rem;
            gap: 0.75rem;
            align-items: center;
            text-decoration: none;
            color: var(--sl-color-gray-2);
            background-color: var(--sl-color-bg);
            border: 1px solid var(--sl-color-gray-5);
            border-radius: 0.75rem;
            padding: 0.5rem 0.875rem;
        }
        a:hover {
            color: var(--sl-color-white);
            border: 1px solid var(--sl-color-gray-3);
        }
    }
</style>
