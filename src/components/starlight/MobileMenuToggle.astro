---
import Icons from "@/components/Icons.astro";
---

<starlight-menu-button class="print:hidden" aria-expanded="false">
    <button
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-label={Astro.locals.t("menuButton.accessibleLabel")}
        aria-controls="starlight__sidebar"
        class="sl-flex lg:sl-hidden"
    >
        <Icons
            name="text-align-justify"
            class="open-menu"
            size="1.125rem"
            color="var(--sl-color-gray-2)"
        />
    </button>
</starlight-menu-button>

<script>
    import { isSidebarOpen, sidebar } from "@/stores/sidebar-store";

    class StarlightMenuButton extends HTMLElement {
        btn = this.querySelector("button")!;
        unsubscribe;

        constructor() {
            super();

            this.btn.addEventListener("click", sidebar.toggle);

            this.unsubscribe = isSidebarOpen.subscribe((expanded) => {
                this.setAttribute("aria-expanded", String(expanded));
                document.body.setAttribute(
                    "data-mobile-menu-expanded",
                    String(expanded),
                );
            });
        }

        disconnectedCallback() {
            this.unsubscribe?.();
        }
    }

    customElements.define("starlight-menu-button", StarlightMenuButton);
</script>

<style>
    @layer starlight.core {
        button {
            border: 0;
            width: fit-content;
            height: auto;
            padding: 0;
            background: none;
            cursor: pointer;
        }

        :global([data-theme="light"]) button {
            color: var(--sl-color-white);
        }
    }
</style>

<style is:global>
    @layer starlight.core {
        [data-mobile-menu-expanded="true"] {
            overflow: hidden;
        }

        @media (min-width: 64rem) {
            [data-mobile-menu-expanded="true"] {
                overflow: auto;
            }
        }
    }
</style>
