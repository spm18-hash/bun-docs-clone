---
import type { TocItem } from "@/types";

interface Props {
    toc: TocItem[];
    depth?: number;
}

const { toc, depth = 0 } = Astro.props;
---

<ul>
    {
        toc.map((heading) => (
            <li>
                <a href={"#" + heading.slug}>
                    <span>{heading.text}</span>
                </a>
                {heading.children.length > 0 && (
                    <Astro.self toc={heading.children} depth={depth + 1} />
                )}
            </li>
        ))
    }
</ul>

<style define:vars={{ depth }}>
    @layer starlight.core {
        ul {
            padding: 0;
            list-style: none;
        }
        a {
            --pad-inline: 1.25rem;
            display: block;
            padding-block: 0.25rem;
            border-left: 1px solid var(--sl-color-gray-6);
            padding-inline: calc(1rem * var(--depth) + var(--pad-inline))
                var(--pad-inline);
            line-height: 1.25;
        }
        a[aria-current="true"] {
            color: var(--sl-color-text-accent);
            border-left: 1px solid var(--sl-color-text-accent);
        }

        li:has(ul li a[aria-current="true"]) > a {
            color: var(--sl-color-text-accent);
            border-left: 1px solid var(--sl-color-text-accent);
            font-weight: 500;
        }
    }
</style>
