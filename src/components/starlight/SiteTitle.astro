---
import logo from "@/assets/logo-with-wordmark-light.svg?raw";
import logoDark from "@/assets/logo-with-wordmark-dark.svg?raw";

const main = Astro.site;
---

<span class="site-title sl-flex">
    <a
        class="astro-logo--light"
        href={main}
        set:html={logo}
        aria-label="Astro"
    />
    <a
        class="astro-logo--dark"
        href={main}
        set:html={logoDark}
        aria-label="Astro"
    />
</span>

<style>
    .site-title {
        gap: 1rem;
    }

    .site-title a {
        display: flex;
    }

    /* Hide the logo that matches the theme appearance */
    :global(:root[data-theme="light"] .astro-logo--light),
    :global(:root[data-theme="dark"] .astro-logo--dark) {
        display: none;
    }

    /* Show the logo that contrasts with the theme */
    :global(:root[data-theme="light"] .astro-logo--dark),
    :global(:root[data-theme="dark"] .astro-logo--light) {
        display: flex;
    }

    .site-title a:focus-visible {
        outline: 0;
    }
    .site-title a:focus-visible > :global(*) {
        outline: auto;
        outline-offset: 0.2rem;
        border-radius: 1px;
    }
    .site-title :global(svg) {
        --display-height: 1.5rem;
        width: auto;
        height: var(--display-height);
        margin-block: calc((var(--sl-nav-height)-var(--display-height)) / 2);
    }
</style>
