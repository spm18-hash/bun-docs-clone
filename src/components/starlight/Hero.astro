---
import Icon from "../Icons.astro";
import MoreActions from "../more-actions/MoreActions.astro";

const { hero } = Astro.locals.starlightRoute.entry.data;

const { title, tagline } = hero!;
---

<div class="hero">
    <div class="page-meta-container">
        <span>Get Started</span>
        <div class="page-title-container">
            <h1 set:text={title} />

            <MoreActions />
        </div>
        <p set:html={tagline} />
        <MoreActions isMobile />
    </div>
</div>

<style>
    .hero {
        margin-top: 1rem;
        padding-bottom: 1rem;
        max-width: 46rem;
        margin-inline: auto;
    }

    :global([data-has-hero] .sl-container) {
        max-width: 100%;
        margin-inline: auto;
    }

    :global([data-has-hero] .sl-markdown-content) {
        max-width: 46rem;
        margin-inline: auto;

        & .level-h2 h2 {
            font-size: var(--sl-text-h3);
        }
    }

    :global([data-has-hero] .sl-markdown-content .level-h2 h2) {
        font-size: var(--sl-text-h3);
    }

    :global([data-has-hero] .sl-markdown-content .level-h3 h3) {
        font-size: var(--sl-text-h4);
    }

    :global([data-has-hero] .sl-container > footer) {
        max-width: 46rem;
        margin-inline: auto;

        @media (width >= 90em) {
            margin-inline: auto;
        }
    }

    span {
        text-transform: capitalize;
        font-size: 0.875em;
        font-weight: 500;
        color: var(--sl-color-text-accent);
    }
    p {
        font-size: var(--sl-text-lg);
        line-height: calc((var(--sl-line-height) / 2) + 0.6);
        margin-top: 0.8rem;
    }
    .page-title-container {
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;

        h1 {
            line-height: 1;
            color: var(--sl-color-white);
            letter-spacing: -0.025em;
        }

        @media (min-width: 48rem) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }
</style>
