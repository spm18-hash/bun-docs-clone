---
import Icon from "../Icons.astro";
const { hero } = Astro.locals.starlightRoute.entry.data;

const { title, tagline } = hero!;
---

<div class="hero">
    <div class="page-meta-container">
        <span>Get Started</span>
        <div class="page-title-container">
            <h1 set:text={title} />

            <div class="page-title-actions">
                <button><div><Icon name="clipboard" />Copy Page</div></button>
                <button><Icon name="chevron-down" /></button>
            </div>
        </div>
        <p set:html={tagline} />
        <div class="page-title-actions page-title-actions--mobile">
            <button><div><Icon name="clipboard" />Copy Page</div></button>
            <button><Icon name="chevron-down" /></button>
        </div>
    </div>
</div>

<style>
    .hero {
        margin-top: 1rem;
        padding-bottom: 1rem;
        max-width: 46rem;
        margin-inline: auto;
    }

    :global([data-has-hero] .sl-container) {
        max-width: 100%;
        margin-inline: auto;
    }

    :global([data-has-hero] .sl-markdown-content) {
        max-width: 46rem;
        margin-inline: auto;
    }

    :global([data-has-hero] .sl-container > footer) {
        max-width: 46rem;
        margin-inline: auto;

        @media (width >= 90em) {
            margin-inline: auto;
        }
    }

    span {
        text-transform: capitalize;
        font-size: 0.875em;
        font-weight: 500;
        color: var(--sl-color-text-accent);
    }
    p {
        font-size: var(--sl-text-lg);
        line-height: calc((var(--sl-line-height) / 2) + 0.6);
        margin-top: 0.8rem;
    }
    .page-title-container {
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;

        h1 {
            line-height: 1;
            color: var(--sl-color-white);
            letter-spacing: -0.025em;
        }

        @media (min-width: 48rem) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .page-title-actions {
        display: none;
        align-items: center;
        flex-shrink: 0;

        @media (min-width: 48rem) {
            display: flex;
        }

        & button {
            background-color: var(--sl-color-bg);
            border: 1px solid var(--sl-color-gray-6);
            padding: 6px 12px;
            font-size: 0.875em;
            color: var(--sl-color-white);
            font-weight: 500;

            &:hover {
                background-color: hsl(from var(--sl-color-red) h s 85% / 0.1);
                border-color: hsl(from var(--sl-color-gray-4) h s l / 0.4);
            }

            & div,
            &:nth-child(2) {
                display: flex;
                align-items: center;
                line-height: 20px;
                gap: 0.7em;
            }

            &:first-child {
                border-radius: 0.85em 0 0 0.85em;
            }

            &:nth-child(2) {
                border-left: none;
                padding: 2px 10px;
                border-radius: 0 0.85em 0.85em 0;

                & svg {
                    height: 28px;
                    color: var(--sl-color-gray-3);
                }
            }
        }
    }

    .page-title-actions--mobile {
        margin-top: 1rem;
        display: flex;

        @media (min-width: 48rem) {
            display: none;
        }
    }
</style>
