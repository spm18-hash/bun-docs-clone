---
import { getRoute } from "node_modules/@astrojs/starlight/utils/routing/data";
const route = await getRoute(Astro);

const mainPaneWidth =
    route.id === "404" ? "100%" : "calc(100% - var(--sl-sidebar-width))";
---

<div class="container">
    {
        Astro.locals.starlightRoute.toc && (
            <aside class="right-sidebar-container print:hidden">
                <div class="right-sidebar">
                    <slot name="right-sidebar" />
                </div>
            </aside>
        )
    }
    <div class="main-pane" style><slot /></div>
</div>

<style define:vars={{ mainPaneWidth }}>
    @layer starlight.core {
        .container {
            padding: 1.25rem;
            gap: 6rem;
            @media (min-width: 48rem) {
                padding: 2rem 3.5rem 1.25rem 3.5rem;
            }
        }
        .main-pane {
            isolation: isolate;
        }

        @media (min-width: 80rem) {
            .container {
                display: flex;
                padding: 2.5rem 2.5rem 0 5.5rem;
            }
            .right-sidebar-container {
                order: 2;
                position: relative;
                width: calc(
                    var(--sl-sidebar-width) +
                        (
                            100% - var(--sl-content-width) -
                                var(--sl-sidebar-width)
                        ) /
                        2
                );
            }

            .right-sidebar {
                position: fixed;
                top: 0;
                padding-top: var(--sl-nav-height);
                width: 100%;
                height: 100vh;
                overflow-y: auto;
                scrollbar-width: none;
            }

            .main-pane {
                width: var(--mainPaneWidth);
            }

            :global([data-has-sidebar][data-has-toc]) .main-pane {
                --sl-content-margin-inline: auto 0;

                order: 1;
                width: calc(
                    var(--sl-content-width) +
                        (
                            100% - var(--sl-content-width) -
                                var(--sl-sidebar-width)
                        ) /
                        2
                );
            }
        }
    }
</style>
