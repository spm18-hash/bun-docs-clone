---
import SiteTitle from "./SiteTitle.astro";
import config from "virtual:starlight/user-config";

import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@/components/starlight/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import Icon from "@/components/Icons.astro";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import TabListItem from "../tabs/TabListItem.astro";
import TabController from "../tabs/TabController.astro";
import Breadcrumb from "../Breadcrumb.astro";
import MobileMenuToggle from "./MobileMenuToggle.astro";

const { sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = StarlightRouteData["sidebar"][number];

type Group = Extract<SidebarEntry, { type: "group" }>;
function assertGroups(sidebar: SidebarEntry[]): asserts sidebar is Group[] {
    for (const entry of sidebar) {
        if (entry.type !== "group") {
            throw new Error(
                "Top-level links are not permitted in the docs sidebar.",
            );
        }
    }
}
assertGroups(sidebar);

const makeId = (label: string) =>
    `__tab-${label.toLowerCase().replaceAll(/\s+/g, "-")}`;
const getIcon = (index: number) =>
    (["cog", "box", "combine", "flask-conical"] as const)[index];

const isCurrent = (sidebar: SidebarEntry[]): boolean =>
    sidebar
        .map((entry) =>
            entry.type === "link" ? entry.isCurrent : isCurrent(entry.entries),
        )
        .some((entry) => entry === true);

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
    config.pagefind ||
    config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header-container">
    <div class="header">
        <div class="title-wrapper sl-flex">
            <SiteTitle />
        </div>
        <div class="sl-flex print:hidden search">
            {shouldRenderSearch && <Search />}
        </div>
        <div class="print:hidden right-group">
            <ThemeSelect />
            <LanguageSelect />
        </div>
    </div>

    <div class="toggle-breadcrumb-container">
        <MobileMenuToggle />
        <Breadcrumb />
    </div>

    <TabController triggerId="main-nav-tabs" panelId="panels">
        <ul
            id="main-nav-tabs"
            role="tablist"
            class:list={["tabbed-list", "sl-flex", Astro.props.class]}
        >
            {
                sidebar.map(({ label, entries }, index) => (
                    <TabListItem
                        id={makeId(label)}
                        initial={isCurrent(entries)}
                        class="tab-item"
                    >
                        <Icon size="1rem" class="icon" name={getIcon(index)} />{" "}
                        {label}
                    </TabListItem>
                ))
            }
        </ul>
    </TabController>
</div>

<style>
    .toggle-breadcrumb-container {
        display: flex;
        align-items: center;
        padding-block: 1rem;
        gap: 1rem;

        @media (min-width: 64rem) {
            display: none;
        }
    }
    @layer starlight.core {
        .header-container {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            max-width: 90rem;
            margin-inline: auto;
        }

        .header {
            display: flex;
            gap: var(--sl-nav-gap);
            justify-content: space-between;
            align-items: center;
            height: 56px;
        }

        .search {
            justify-content: end;

            @media (min-width: 64rem) {
                flex: 1;
                justify-content: center;
            }
        }

        .title-wrapper {
            /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
            overflow: clip;
            /* Avoid clipping focus ring around link inside title wrapper. */
            padding: 0.25rem;
            margin: -0.25rem;
            flex: 1;
        }
        .right-group {
            display: none;

            @media (min-width: 64rem) {
                display: flex;
                justify-content: end;
                flex: 1;
            }
        }

        @media (min-width: 50rem) {
            :global(:root[data-has-sidebar]) {
                --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
            }
            :global(:root:not([data-has-toc])) {
                --__toc-width: 0rem;
            }
            .header {
                display: flex;
                align-items: center;
                align-content: center;
            }
        }
    }

    .tabbed-list {
        /* Layout variables */
        --tab-switcher-border-width: 1px;
        --tab-switcher-padding: calc(
            0.25rem - var(--tab-switcher-border-width)
        );

        /* Color variables */
        --tab-switcher-border-color: var(--sl-color-red);
        --tab-switcher-background-color: var(
            --sl-color-gray-7,
            var(--sl-color-gray-6)
        );
        --tab-switcher-text-color: var(--sl-color-gray-3);
        --tab-switcher-text-color--active: var(--sl-color-red);
        --tab-switcher-icon-color: var(--sl-color-gray-4);
        --tab-switcher-icon-color--active: var(--sl-color-text-accent);
        --tab-item-background-color--hover: var(--sl-color-gray-6);
    }
    /* Dark theme variations */
    :global([data-theme="dark"]) .tabbed-list {
        --tab-switcher-text-color: var(--sl-color-gray-2);
        --tab-switcher-icon-color: var(--sl-color-gray-3);
        --tab-item-background-color--hover: var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
        /* Dark theme variations with the desktop sidebar visible */
        :global([data-theme="dark"]) .tabbed-list {
            --tab-switcher-background-color: var(--sl-color-black);
            --tab-item-background-color--hover: var(--sl-color-gray-6);
        }
    }

    .tabbed-list {
        display: none;
        list-style: none;
        gap: 1.5rem;
        padding: 0;
        height: 40px;

        @media (min-width: 64em) {
            display: flex;
            flex: 1;
        }
    }
    .tabbed-list--styled {
        display: flex;
        margin-top: -1px;
        overflow-x: auto;
        overflow-y: hidden;
    }
    .tab-item :global(a:hover) .icon {
        color: inherit;
    }
    .tab-item :global(a) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        height: 100%;
        text-decoration: none;
        color: var(--tab-switcher-text-color);
        font-weight: 600;
    }
</style>
