---
import { PAGE_TITLE_ID } from "@/const";
import MoreActions from "@/components/more-actions/MoreActions.astro";
import { getActiveBreadcrumb } from "@/components/Breadcrumb.astro";

const {
    sidebar,
    entry: {
        data: { title: currentPage, description },
    },
} = Astro.locals.starlightRoute;

const { parent, current } = getActiveBreadcrumb(sidebar, currentPage);
---

<div class="page-meta-container">
    <span>{parent}</span>
    <div class="page-title-container">
        <h1 id={PAGE_TITLE_ID} class="page-title">
            {current}
        </h1>
        <MoreActions />
    </div>
    <p>{description}</p>
    <MoreActions isMobile />
</div>

<style>
    .page-meta-container {
        margin-top: 1rem;
    }
    span {
        text-transform: capitalize;
        font-size: 0.875em;
        font-weight: 500;
        color: var(--sl-color-text-accent);
    }
    p {
        font-size: var(--sl-text-lg);
        line-height: calc((var(--sl-line-height) / 2) + 0.6);
        margin-top: 0.8rem;
    }
    .page-title-container {
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;

        @media (min-width: 48rem) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .page-title-actions {
        display: none;
        align-items: center;
        flex-shrink: 0;

        @media (min-width: 48rem) {
            display: flex;
        }

        & button {
            background-color: var(--sl-color-bg);
            border: 1px solid var(--sl-color-gray-6);
            padding: 6px 12px;
            font-size: 0.875em;
            color: var(--sl-color-white);
            font-weight: 500;

            &:hover {
                background-color: hsl(from var(--sl-color-red) h s 85% / 0.1);
                border-color: hsl(from var(--sl-color-gray-4) h s l / 0.4);
            }

            & div,
            &:nth-child(2) {
                display: flex;
                align-items: center;
                line-height: 20px;
                gap: 0.7em;
            }

            &:first-child {
                border-radius: 0.85em 0 0 0.85em;
            }

            &:nth-child(2) {
                border-left: none;
                padding: 2px 10px;
                border-radius: 0 0.85em 0.85em 0;

                & svg {
                    height: 28px;
                    color: var(--sl-color-gray-3);
                }
            }
        }
    }

    .page-title-actions--mobile {
        margin-top: 1rem;
        display: flex;

        @media (min-width: 48rem) {
            display: none;
        }
    }

    @layer starlight.core {
        h1 {
            font-size: var(--sl-text-h1);
            line-height: var(--sl-line-height-headings);
            font-weight: 600;
            color: var(--sl-color-white);
        }
    }
</style>
