---
import Pagination from "@/components/starlight/Pagination.astro";
import FooterPageLink from "@/components/FooterPageLink.astro";
import FeedbackButton from "../FeedbackButton.astro";
import SocialIcons from "./SocialIcons.astro";

import { getRoute } from "node_modules/@astrojs/starlight/utils/routing/data";
const route = await getRoute(Astro);

const { editUrl } = Astro.locals.starlightRoute;
---

{
    route.id !== "404" && (
        <footer class="sl-flex">
            <div class="sl-flex link-container">
                <div class="sl-flex page-helpful">
                    <p>Was this page helpful?</p>
                    <div class="meta sl-flex">
                        <div class="sl-flex button-group">
                            <FeedbackButton label="Yes" icon="thumbs-up" />
                            <FeedbackButton label="No" icon="thumbs-down" />
                        </div>
                        <div class="sl-flex button-group">
                            {editUrl && (
                                <FooterPageLink
                                    href={editUrl}
                                    label="Suggest edits"
                                    icon="pencil"
                                />
                            )}
                            <FooterPageLink
                                href={"/"}
                                label="Raise issue"
                                icon="triangle-alert"
                            />
                        </div>
                    </div>
                </div>
                <Pagination />
            </div>
            <div class="sl-flex social-icons">
                <SocialIcons />
            </div>
        </footer>
    )
}

<style>
    @layer starlight.core {
        footer,
        .link-container {
            flex-direction: column;
            gap: 1.5rem;
        }
        .link-container {
            padding-block-end: 6rem;
            border-bottom: 1px solid var(--sl-color-gray-6);
        }
        .social-icons {
            gap: 1.5rem;
            align-items: center;
            margin-top: 1.5rem;
        }

        .page-helpful {
            margin-block: 4rem 3rem;
            gap: 1rem;
            flex-direction: column;
            justify-content: space-between;
        }
        p {
            display: inline-block;
            white-space: nowrap;
            font-size: var(--sl-text-sm);
        }
        .meta {
            gap: 0.75rem 1rem;
            justify-content: space-between;
            flex-wrap: wrap;
            font-size: var(--sl-text-sm);
            color: var(--sl-color-gray-3);
            flex-grow: 1;
        }
        .meta > :global(p:only-child) {
            margin-inline-start: auto;
        }

        .button-group {
            gap: 0.75rem;
        }
    }
</style>
