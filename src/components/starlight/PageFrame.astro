---
const { hasSidebar } = Astro.locals.starlightRoute;
import Icon from "@/components/Icons.astro";
---

<div class="page sl-flex">
    <header class="header"><slot name="header" /></header>
    <div class="content">
        {
            hasSidebar && (
                <nav
                    class="sidebar print:hidden"
                    aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
                >
                    <div id="starlight__sidebar" class="sidebar-pane">
                        <div class="sidebar-backdrop" id="sidebar-backdrop" />
                        <button
                            id="sidebar-close-button"
                            class="sidebar-close-button"
                        >
                            <Icon name="close" />
                        </button>
                        <div class="sidebar-content sl-flex">
                            <slot name="sidebar" />
                        </div>
                    </div>
                </nav>
            )
        }
        <div class="main-frame"><slot /></div>
    </div>
</div>

<script>
    import { isSidebarOpen } from "@/stores/sidebar-store";

    const closeButton = document.getElementById("sidebar-close-button");
    const sidebarBackdrop = document.getElementById("sidebar-backdrop");

    const elements = [closeButton, sidebarBackdrop].filter(
        (el): el is HTMLElement => el != null,
    );

    elements.forEach((element) => {
        element.addEventListener("click", () => {
            isSidebarOpen.set(false);
        });
    });
</script>

<style>
    @layer starlight.core {
        /* Base Layout & Variables */
        .page {
            --sidebar-height: 100svh;
            --sidebar-width: 88dvw;
            --sidebar-max-width: 20rem;
            --sidebar-min-width: 18rem;
            --sidebar-transition: all 200ms ease-in-out;

            flex-direction: column;
            min-height: 100vh;
            position: relative;
        }

        .content {
            max-width: 90rem;
            width: 100%;
            margin-inline: auto;
            display: flex;
        }

        .header {
            z-index: var(--sl-z-index-navbar);
            position: fixed;
            inset-block-start: 0;
            inset-inline: 0;
            height: var(--sl-nav-height);
            border-bottom: 1px solid var(--sl-color-hairline-shade);
            padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
            background-color: var(--sl-color-bg-nav);
        }

        .main-frame {
            min-height: 100vh;
            padding-top: var(--sl-nav-height);
            width: 100%;
        }

        :global([data-has-sidebar]) .header {
            padding-inline-end: var(--sl-nav-pad-x);
        }

        /* --- Sidebar styles --- */

        :is(.sidebar-backdrop, .sidebar-content, .sidebar-close-button) {
            transition: var(--sidebar-transition);
        }

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            height: var(--sidebar-height);
            background-color: hsl(from var(--sl-color-bg) h s l / 0.6);
            backdrop-filter: blur(4px);
            z-index: 19;
            opacity: 0;
        }

        .sidebar-pane {
            visibility: var(--sl-sidebar-visibility, hidden);
            position: fixed;
            z-index: var(--sl-z-index-menu);
            inset-block: 0;
            inset-inline-start: 0;
            width: 100%;
            height: var(--sidebar-height);
        }

        .sidebar-close-button {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            top: 0.65rem;
            right: 0.9rem;
            width: 1.5em;
            height: 1.5em;
            font-size: 1.5em;
            z-index: 20;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--sl-color-gray-3);
            opacity: 0;
        }

        .sidebar-content {
            position: relative;
            z-index: 20;
            height: var(--sidebar-height);
            padding: 1rem var(--sl-sidebar-pad-x);
            flex-direction: column;
            gap: 1.75rem;
            width: 88dvw;
            min-width: var(--sidebar-min-width);
            max-width: var(--sidebar-max-width);
            overflow-y: scroll;
            background-color: var(--sl-color-bg);
            transform: translateX(-100%);
            scrollbar-width: none;
        }

        /* --- Expanded Sidebar state --- */
        body:has(starlight-menu-button[aria-expanded="true"]) {
            & .sidebar-pane {
                --sl-sidebar-visibility: visible;
            }
            & :is(.sidebar-content, .sidebar-backdrop, .sidebar-close-button) {
                opacity: 1;
            }
            & .sidebar-content {
                transform: translateX(0);
            }
        }

        @media (min-width: 50rem) {
            .sidebar-content::after {
                content: "";
                padding-bottom: 1px;
            }
        }

        @media (min-width: 64rem) {
            :is(.sidebar-backdrop, .sidebar-close-button) {
                display: none;
            }

            .sidebar-pane {
                position: sticky;
                --sl-sidebar-visibility: visible;
                width: var(--sl-sidebar-width);
                background-color: transparent;
                border-inline-end: 1px solid var(--sl-color-hairline-shade);
                z-index: 5;
                inset-block-start: var(--sl-nav-height);
            }

            .sidebar-content {
                position: unset;
                width: 100%;
                min-width: auto;
                max-width: none;
                background-color: transparent;
                transform: unset;
            }
        }

        @media (min-width: 105rem) {
            .sidebar-content {
                padding-left: 0;
            }
        }
    }
</style>
