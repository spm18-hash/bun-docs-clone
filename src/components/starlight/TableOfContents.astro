---
import TableOfContentsList from "./TableOfContents/TableOfContentsList.astro";
import Icons from "../Icons.astro";

const { toc } = Astro.locals.starlightRoute;
---

{
    toc && (
        <starlight-toc
            data-min-h={toc.minHeadingLevel}
            data-max-h={toc.maxHeadingLevel}
        >
            <nav aria-labelledby="starlight__on-this-page">
                <div class="sl-flex toc-title">
                    <Icons name="text-align-start" />
                    <h2 id="starlight__on-this-page">
                        {Astro.locals.t("tableOfContents.onThisPage")}
                    </h2>
                </div>
                <TableOfContentsList toc={toc.items} />
            </nav>
        </starlight-toc>
    )
}

<style>
    nav {
        margin-top: 1.5rem;

        & .toc-title {
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
    }
</style>

<script src="./TableOfContents/starlight-toc"></script>
